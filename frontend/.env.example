# ==============================================================================
# NyayaVault Frontend Environment Configuration Example
# ==============================================================================
# Copy this file to .env or .env.local to configure your local development setup.
# IMPORTANT: Never commit actual secret keys, passwords, or blockchain keys here.
# Vite exposes variables prefixed with VITE_ to the browser bundle.

# Centralized API Base URL for backend communication
# Default local development port for Member 3 API server:
VITE_API_BASE_URL=http://localhost:4000/api

# Mock Adapter Mode:
# - Set to "true" to run with client-side isolated mock data (no backend needed)
# - Set to "false" to route all API calls directly to VITE_API_BASE_URL
VITE_USE_MOCK_API=true
