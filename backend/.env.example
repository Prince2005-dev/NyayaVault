# NyayaVault Backend Security & Storage Configuration
# ===================================================
# DOCUMENT_ENCRYPTION_KEY must be exactly 32 bytes (256 bits), Base64 encoded.
# Generate a fresh key using: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=
DOCUMENT_ENCRYPTION_KEY_VERSION=v1

# Secure Local Storage Root Directory (outside of public/client web paths)
STORAGE_PROVIDER=local
STORAGE_ROOT_DIR=./storage
# Production S3/R2 storage
# AWS_S3_BUCKET_NAME=
# AWS_REGION=
# AWS_S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Server Configuration
PORT=4000
# Production frontend origin URL for CORS validation (optional in local development, e.g. https://vault.example.com)
CORS_ORIGIN=

# Blockchain Network Configuration (Local Hardhat Node)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Option A: Docker PostgreSQL (default docker-compose service)
#   DATABASE_URL=postgresql://postgres:<password>@localhost:5432/nyayavault?schema=public
#
# Option B: Native Local PostgreSQL
#   Update USER, PASSWORD, and PORT to match your local PostgreSQL service installation:
#   DATABASE_URL=postgresql://<user>:<password>@localhost:5432/nyayavault?schema=public
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/nyayavault?schema=public

# Authentication & JWT Configuration
# Minimum 32-character secret string.
# Generate a fresh secret using: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
